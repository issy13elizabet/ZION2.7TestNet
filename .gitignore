*SECRET*
*password*
*PASSWORD*
*api_key*
*API_KEY*
config/production/
config/secrets/
*production.yml
*production.yaml
*secrets.yml
*secrets.yaml

# 🚫 LOGS WITH SENSITIVE INFO
*.log
logs/
api.log
error.log
debug.log
*_access.log
*production*.log

# 🚫 MINING POOL CONFIGS
